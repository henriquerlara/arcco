# DEPLOY — homologação grátis (Neon + Render).
# Cole estes valores no painel do Render. Não commite a cópia preenchida.
NODE_ENV=production
PORT=10000
FRONTEND_URL=https://arcco-web.onrender.com
API_PUBLIC_URL=https://arcco-api.onrender.com

# Neon: um projeto, dois databases. sslmode=require é obrigatório.
PLATFORM_DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/platform_db?sslmode=require
EMPRESA_DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/db_empresa_arcco?sslmode=require

JWT_ACCESS_SECRET=troque-por-um-segredo-longo-de-deploy
JWT_REFRESH_SECRET=troque-por-outro-segredo-longo-de-deploy
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
OTEL_SERVICE_NAME=arcco-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# O Vite grava esta URL no build do painel. Tem de ser a URL pública da API.
VITE_API_URL=https://arcco-api.onrender.com
VITE_APP_NAME=ARCCO
VITE_META_APP_ID=
VITE_META_WHATSAPP_CONFIG_ID=

META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_WHATSAPP_VERIFY_TOKEN=arcco-meta-verify-change-me
META_GRAPH_API_VERSION=v26.0
META_WHATSAPP_TEST_RECIPIENT=
META_WHATSAPP_DISPLAY_PHONE=

FOCUS_NFE_TOKEN=
FOCUS_NFE_ENV=homologacao
FOCUS_NFE_REF_PREFIX=arcco
