# LOCAL — Postgres 17 desta máquina. Copie para .env na raiz e em apps/api/.env
# Não use este arquivo no Render. Lá as variáveis entram no painel.
PLATFORM_DATABASE_URL=postgresql://arcco:arcco@localhost:5432/platform_db
EMPRESA_DATABASE_URL=postgresql://arcco:arcco@localhost:5432/db_empresa_arcco
SAUDE_DATABASE_URL=postgresql://arcco:arcco@localhost:5432/db_clinica_arcco
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_SECRET=altere-este-segredo-access-em-producao-min-32
JWT_REFRESH_SECRET=altere-este-segredo-refresh-em-producao-min-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# WhatsApp — Meta Cloud API (variáveis META_* mais abaixo)
API_PUBLIC_URL=http://localhost:3000

AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
OTEL_SERVICE_NAME=arcco-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# WEB
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=ARCCO

# Meta WhatsApp Cloud API (frontend — só IDs públicos)
# NUNCA expor META_APP_SECRET / ACCESS_TOKEN no frontend.
VITE_META_APP_ID=
VITE_META_WHATSAPP_CONFIG_ID=
# VITE_META_GRAPH_VERSION=v21.0

# Meta WhatsApp Cloud API (BACKEND ONLY)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_WHATSAPP_VERIFY_TOKEN=arcco-meta-verify-change-me
META_GRAPH_API_VERSION=v26.0
META_WHATSAPP_TEST_RECIPIENT=
# Opcional: número de exibição do remetente de teste
META_WHATSAPP_DISPLAY_PHONE=

# Focus NFe (BACKEND ONLY) — emissão NF-e
FOCUS_NFE_TOKEN=
FOCUS_NFE_ENV=homologacao
FOCUS_NFE_REF_PREFIX=arcco
