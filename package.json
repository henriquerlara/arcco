{
  "name": "arcco",
  "version": "0.1.0",
  "private": true,
  "description": "ARCCO — Inteligência Comercial",
  "scripts": {
    "dev:api": "pnpm --filter @arcco/api dev",
    "dev:web": "pnpm --filter @arcco/web dev",
    "build": "pnpm --filter @arcco/contratos build && pnpm --filter @arcco/api build && pnpm --filter @arcco/web build",
    "build:api": "pnpm --filter @arcco/contratos build && pnpm --filter @arcco/api build",
    "build:web": "pnpm --filter @arcco/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @arcco/web test:e2e",
    "db:generate": "pnpm --filter @arcco/api prisma:generate",
    "db:migrate": "pnpm --filter @arcco/api prisma:migrate",
    "db:seed": "pnpm --filter @arcco/api prisma:seed",
    "db:push": "pnpm --filter @arcco/api prisma:push",
    "format": "prettier --write \"**/*.{ts,vue,json,md}\""
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
