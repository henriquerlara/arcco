// Database operacional da empresa (segmento construção), por enquanto um só: db_empresa_arcco.
// Empresa e usuário ficam em prisma/platform.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("EMPRESA_DATABASE_URL")
}

// ======================= ENUMS =======================

enum TipoContato {
  PROPRIETARIO_OBRA
  ARQUITETO
  ENGENHEIRO
  CONSTRUTORA
  INSTALADOR
  COMPRADOR
  EMPRESA
  OUTRO
}

/// ECOL-09a: PF/PJ. Nulo nos contatos legados e em empresas sem a flag.
enum NaturezaPessoa {
  PF
  PJ
}

/// ECOL-10a: tipo de parceria. Nulo se não for parceiro / legado.
enum TipoParceiro {
  ARQUITETO_DESIGNER
  INSTALADOR_ELETRICISTA
  CONSTRUTORA
}

/// ECOL-11: origem do negócio (só ECOLUME). Nulo no legado OP-.
enum OrigemNegocio {
  CLIENTE_DIRETO
  VIA_PARCEIRO
}

enum StatusObra {
  PLANEJAMENTO
  EM_ANDAMENTO
  PAUSADA
  CONCLUIDA
  CANCELADA
}

enum TipoEtapaFunil {
  ABERTA
  GANHA
  PERDIDA
}

enum OrigemHistoricoEtapa {
  CRIACAO
  MANUAL
  CHATBOT
  ORCAMENTO_WHATSAPP
}

enum PrioridadeOportunidade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum TipoAtividade {
  LIGACAO
  MENSAGEM
  REUNIAO
  ENVIAR_ORCAMENTO
  REVISAR_ORCAMENTO
  FOLLOW_UP
  TAREFA
  ENTREGA
  VISITA
}

enum ProvedorWhatsApp {
  MOCK
  META
}

enum StatusConexaoWhatsApp {
  DESCONECTADO
  CONECTANDO
  QR_CODE
  CONECTADO
  ERRO
}

enum StatusConversa {
  BOT_ATENDENDO
  AGUARDANDO_HUMANO
  EM_ATENDIMENTO
  AGUARDANDO_CLIENTE
  FINALIZADA
}

enum ModoAtendimento {
  BOT
  HUMANO
  PAUSADO
}

enum DirecaoMensagem {
  RECEBIDA
  ENVIADA
}

enum TipoMensagem {
  TEXTO
  IMAGEM
  AUDIO
  DOCUMENTO
  LOCALIZACAO
  SISTEMA
}

enum StatusMensagem {
  RECEBIDA
  PROCESSANDO
  ENVIADA
  ENTREGUE
  LIDA
  ERRO
}

enum EntidadeCampoPersonalizado {
  CONTATO
  OBRA
  OPORTUNIDADE
}

enum TipoCampoPersonalizado {
  TEXTO
  TEXTO_LONGO
  NUMERO
  MOEDA
  DATA
  BOOLEANO
  SELECAO
  MULTISSELECAO
}

enum StatusOrcamento {
  RASCUNHO
  ENVIADO
  ACEITO
  CANCELADO
  CONVERTIDO
  /// ECOL-12 — orçamento enviado substituído por outro no mesmo negócio.
  SUBSTITUIDO
  /// ECOL-12 — recusado; somente leitura.
  RECUSADO
}

enum StatusNotaFiscal {
  RASCUNHO
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
}

/// ECOL-16 — ciclo do pedido. Pagamentos/checklist/baixa entram na ECOL-17.
enum StatusPedido {
  CONFIRMADO
  FINALIZADO
  CANCELADO
}

/// ECOL-19 � coluna p�s-venda do pedido (CANCELADO/FINALIZADO usam StatusPedido).
enum FaseKanbanPedido {
  PEDIDO_CONFIRMADO
  EM_SEPARACAO
  PRONTO_ENTREGA
  ENTREGUE
}

enum ModeloPagamentoPedido {
  PIX_AVISTA
  CARTAO_CREDITO
  CARTAO_DEBITO
  SINAL_RESTANTE_ENTREGA
  SINAL_BOLETOS
  PERSONALIZADO
}

enum StatusPagamentoPedido {
  PREVISTO
  RECEBIDO
}

enum StatusComissaoPedido {
  A_PAGAR
  PAGA
  CANCELADA
}

enum TipoChecklistPedido {
  PAGAMENTO_RECEBIDO
  ITENS_COMPRADOS
  MATERIAL_SEPARADO
  NF_EMITIDA
  ENTREGUE
  COMISSAO_PAGA
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  BAIXA
  AJUSTE
}

// ======================= MODELOS =======================

model Contato {
  id                  String      @id @default(uuid())
  empresaId           String
  nome                String
  telefone            String
  telefoneNormalizado String
  email               String?
  tipo                TipoContato @default(OUTRO)
  empresaNome         String?
  /// CPF ou CNPJ do destinatário fiscal (dígitos).
  documento           String?
  origem              String?
  observacoes         String?
  responsavelId       String?
  dadosPersonalizados Json        @default("{}")
  /// ECOL-09a — nulo fora da flag / cadastros antigos.
  natureza            NaturezaPessoa?
  nomeFantasia        String?
  inscricaoEstadual   String?
  ieIsento            Boolean     @default(false)
  cep                 String?
  logradouro          String?
  numero              String?
  complemento         String?
  bairro              String?
  cidade              String?
  uf                  String?
  /// Telefones adicionais: [{ numero, normalizado }].
  telefonesExtras     Json        @default("[]")
  /// Contatos da PJ: [{ nome, cargo, telefone, email }].
  pessoasEmpresa      Json        @default("[]")
  /// Etiqueta de parceria (ECOL-09a/10a).
  ehParceiro          Boolean     @default(false)
  /// ECOL-10a — preenchidos com ehParceiro; preservados ao desmarcar.
  tipoParceiro        TipoParceiro?
  /// Percentual RT do parceiro (ex.: 10.50).
  rtPadrao            Decimal?    @db.Decimal(7, 4)
  chavePix            String?
  banco               String?
  agencia             String?
  conta               String?
  titularNome         String?
  titularDocumento    String?
  observacoesParceria String?
  criadoEm            DateTime    @default(now())
  atualizadoEm        DateTime    @updatedAt

  oportunidades        Oportunidade[] @relation("ClienteOportunidade")
  negociosComoParceiro Oportunidade[] @relation("ParceiroOportunidade")
  atividades           Atividade[]
  contatosObras        ContatoObra[]
  conversas            Conversa[]

  @@unique([empresaId, telefoneNormalizado])
  @@index([empresaId])
  @@index([empresaId, nome])
  @@index([empresaId, documento])
  @@index([empresaId, natureza])
  @@index([empresaId, cidade])
  @@index([empresaId, ehParceiro])
  @@index([responsavelId])
  @@map("contatos")
}

model Obra {
  id                  String     @id @default(uuid())
  empresaId           String
  nome                String
  identificacao       String?
  tipo                String?
  status              StatusObra @default(PLANEJAMENTO)
  endereco            String?
  bairro              String?
  cidade              String?
  estado              String?
  cep                 String?
  previsao            DateTime?
  observacoes         String?
  dadosPersonalizados Json       @default("{}")
  criadoEm            DateTime   @default(now())
  atualizadoEm        DateTime   @updatedAt

  oportunidades Oportunidade[]
  atividades    Atividade[]
  contatosObras ContatoObra[]

  @@index([empresaId])
  @@index([empresaId, status])
  @@map("obras")
}

model ContatoObra {
  id        String   @id @default(uuid())
  empresaId String
  contatoId String
  obraId    String
  papel     String
  criadoEm  DateTime @default(now())

  contato Contato @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  obra    Obra    @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@unique([empresaId, contatoId, obraId, papel])
  @@index([empresaId])
  @@index([contatoId])
  @@index([obraId])
  @@map("contatos_obras")
}

model Categoria {
  id           String   @id @default(uuid())
  empresaId    String
  nome         String
  descricao    String?
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  oportunidades Oportunidade[]

  @@index([empresaId])
  @@map("categorias")
}

model EtapaFunil {
  id           String         @id @default(uuid())
  empresaId    String
  nome         String
  ordem        Int
  tipo         TipoEtapaFunil @default(ABERTA)
  /// Chave estável para automação (ex.: QUALIFICACAO). Null em etapas criadas pelo usuário.
  chaveSistema String?
  ativo        Boolean        @default(true)
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt

  oportunidades Oportunidade[]

  @@unique([empresaId, chaveSistema])
  @@index([empresaId])
  @@index([empresaId, ordem])
  @@map("etapas_funil")
}

model Oportunidade {
  id                  String                 @id @default(uuid())
  empresaId           String
  codigo              String
  titulo              String
  contatoId           String
  obraId              String?
  categoriaId         String?
  etapaId             String
  responsavelId       String?
  descricao           String?
  origem              String?
  prioridade          PrioridadeOportunidade @default(MEDIA)
  valorEstimado       Float?
  previsaoFechamento  DateTime?
  proximaAcao         String?
  dataProximaAcao     DateTime?
  codigoOrcamento     String?
  motivoPerda         String?
  dadosPersonalizados Json                   @default("{}")
  /// ECOL-11 — nulos no legado / sem flag.
  origemNegocio       OrigemNegocio?
  parceiroId          String?
  rtNegocio           Decimal?               @db.Decimal(7, 4)
  obraCep             String?
  obraLogradouro      String?
  obraNumero          String?
  obraComplemento     String?
  obraBairro          String?
  obraCidade          String?
  obraUf              String?
  fechadaEm           DateTime?
  criadoEm            DateTime               @default(now())
  atualizadoEm        DateTime               @updatedAt

  contato    Contato    @relation("ClienteOportunidade", fields: [contatoId], references: [id], onDelete: Cascade)
  parceiro   Contato?   @relation("ParceiroOportunidade", fields: [parceiroId], references: [id], onDelete: SetNull)
  obra       Obra?      @relation(fields: [obraId], references: [id])
  categoria  Categoria? @relation(fields: [categoriaId], references: [id])
  etapa           EtapaFunil                   @relation(fields: [etapaId], references: [id])
  atividades      Atividade[]
  historicoEtapas HistoricoEtapaOportunidade[]
  eventos         EventoOportunidade[]
  orcamentos      Orcamento[]
  pedidos         Pedido[]
  notasFiscais    NotaFiscal[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([empresaId, etapaId])
  @@index([empresaId, responsavelId])
  @@index([contatoId])
  @@index([parceiroId])
  @@index([empresaId, origemNegocio])
  @@map("oportunidades")
}

model HistoricoEtapaOportunidade {
  id                String               @id @default(uuid())
  empresaId         String
  oportunidadeId    String
  etapaId           String
  etapaNome         String
  etapaAnteriorId   String?
  etapaAnteriorNome String?
  origem            OrigemHistoricoEtapa
  usuarioId         String?
  criadoEm          DateTime             @default(now())

  oportunidade Oportunidade @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([oportunidadeId, criadoEm])
  @@map("historicos_etapa_oportunidade")
}

/// Fonte única da timeline. Eventos são imutáveis e derivados de ações reais do produto.
model EventoOportunidade {
  id             String   @id @default(uuid())
  empresaId      String
  oportunidadeId String
  tipo           String
  titulo         String
  descricao      String?
  origem         String   @default("SISTEMA")
  dados          Json     @default("{}")
  usuarioId      String?
  criadoEm       DateTime @default(now())

  oportunidade Oportunidade @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)

  @@index([empresaId, criadoEm])
  @@index([oportunidadeId, criadoEm])
  @@map("eventos_oportunidade")
}

model Atividade {
  id             String        @id @default(uuid())
  empresaId      String
  oportunidadeId String?
  contatoId      String?
  obraId         String?
  /// ECOL-20 � v�nculo opcional a pedido (obrigat�rio se tipo ENTREGA).
  pedidoId       String?
  responsavelId  String
  tipo           TipoAtividade
  titulo         String
  descricao      String?
  vencimento     DateTime
  /// ECOL-20 � compromisso de dia inteiro (sem hor�rio).
  diaInteiro     Boolean       @default(false)
  /// ECOL-20 � MANHA | TARDE quando sem hor�rio exato.
  periodoDia     String?
  local          String?
  entregaCep           String?
  entregaLogradouro    String?
  entregaNumero        String?
  entregaComplemento   String?
  entregaBairro        String?
  entregaCidade        String?
  entregaUf            String?
  contatoLocalNome     String?
  contatoLocalTelefone String?
  /// PARCIAL | FINAL ap�s conclus�o de entrega.
  conclusaoEntrega String?
  resultadoConclusao String?
  concluida      Boolean       @default(false)
  concluidaEm    DateTime?
  concluidaPorId String?
  criadoEm       DateTime      @default(now())
  atualizadoEm   DateTime      @updatedAt

  oportunidade Oportunidade? @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  contato      Contato?      @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  obra         Obra?         @relation(fields: [obraId], references: [id], onDelete: Cascade)
  pedido       Pedido?       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([empresaId, responsavelId])
  @@index([empresaId, concluida, vencimento])
  @@index([oportunidadeId])
  @@index([pedidoId])
  @@index([empresaId, tipo, concluida, vencimento])
  @@map("atividades")
}

model ConexaoWhatsApp {
  id                String                @id @default(uuid())
  empresaId         String
  nomeInstancia     String                @unique
  provedor          ProvedorWhatsApp      @default(MOCK)
  status            StatusConexaoWhatsApp @default(DESCONECTADO)
  /// cloud_api | coexistence
  modoConexao       String?
  wabaId            String?
  phoneNumberId     String?
  isTestConnection  Boolean               @default(false)
  numero            String?
  qrCode            String?
  ultimoErro        String?
  conectadoEm       DateTime?
  criadoEm          DateTime              @default(now())
  atualizadoEm      DateTime              @updatedAt

  conversas Conversa[]

  @@index([empresaId])
  @@index([phoneNumberId])
  @@map("conexoes_whatsapp")
}

model Conversa {
  id                   String          @id @default(uuid())
  empresaId            String
  conexaoId            String?
  contatoId            String?
  telefone             String
  telefoneNormalizado  String
  nomeContato          String?
  status               StatusConversa  @default(BOT_ATENDENDO)
  modo                 ModoAtendimento @default(BOT)
  estadoBot            Json?
  intencaoAtual        String?
  atendenteId          String?
  oportunidadeId       String?
  naoLidas             Int             @default(0)
  ultimaMensagemEm     DateTime?
  ultimaMensagemPreview String?
  criadoEm             DateTime        @default(now())
  atualizadoEm         DateTime        @updatedAt

  conexao   ConexaoWhatsApp? @relation(fields: [conexaoId], references: [id])
  contato   Contato?         @relation(fields: [contatoId], references: [id])
  mensagens Mensagem[]

  @@index([empresaId])
  @@index([empresaId, status])
  @@index([empresaId, telefoneNormalizado])
  @@index([empresaId, atualizadoEm])
  @@map("conversas")
}

model Mensagem {
  id             String          @id @default(uuid())
  empresaId      String
  conversaId     String
  idExterno      String?
  direcao        DirecaoMensagem
  tipo           TipoMensagem    @default(TEXTO)
  conteudo       String
  status         StatusMensagem  @default(ENVIADA)
  remetente      String?
  autorUsuarioId String?
  arquivoId      String?
  metadados      Json?
  criadoEm       DateTime        @default(now())

  conversa Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@unique([conversaId, idExterno])
  @@index([empresaId])
  @@index([conversaId, criadoEm])
  @@map("mensagens")
}

model Arquivo {
  id                String   @id @default(uuid())
  empresaId         String
  nome              String
  nomeArmazenamento String
  tipoMime          String
  tamanho           Int
  provedor          String   @default("local")
  caminho           String
  url               String?
  entidade          String?
  entidadeId        String?
  enviadoPorId      String?
  criadoEm          DateTime @default(now())


  @@index([empresaId])
  @@index([empresaId, entidade, entidadeId])
  @@map("arquivos")
}

model CampoPersonalizado {
  id            String                     @id @default(uuid())
  empresaId     String
  entidade      EntidadeCampoPersonalizado
  chave         String
  rotulo        String
  descricao     String?
  tipo          TipoCampoPersonalizado
  obrigatorio   Boolean                    @default(false)
  opcoes        Json                       @default("[]")
  ordem         Int                        @default(0)
  ativo         Boolean                    @default(true)
  usarNoChatbot Boolean                    @default(false)
  textoPergunta String?
  mostrarNoResumo Boolean                  @default(true)
  permitirFiltro Boolean                   @default(false)
  criadoEm      DateTime                   @default(now())
  atualizadoEm  DateTime                   @updatedAt


  @@unique([empresaId, entidade, chave])
  @@index([empresaId, entidade])
  @@map("campos_personalizados")
}

model Fornecedor {
  id           String   @id @default(uuid())
  empresaId    String
  nome         String
  nomeCurto    String?
  cnpj         String
  /// ST% (0–100). Obrigatório; zero permitido. Resposta sujeita a VER_CUSTOS.
  aliquotaSt   Decimal  @db.Decimal(7, 4)
  contatoNome  String?
  telefone     String?
  email        String?
  observacoes  String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  produtos     Produto[]
  notasEntrada NotaEntrada[]

  @@unique([empresaId, cnpj])
  @@index([empresaId, ativo])
  @@map("fornecedores")
}

/// NF-e de compra importada (ECOL-07). Chave única por empresa.
model NotaEntrada {
  id            String   @id @default(uuid())
  empresaId     String
  fornecedorId  String
  chaveAcesso   String
  numero        String?
  serie         String?
  emitidoEm     DateTime?
  valorTotal    Decimal  @db.Decimal(18, 4)
  arquivoXmlId  String?
  status        String   @default("CONFERIDA")
  criadoPorId   String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  fornecedor Fornecedor        @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)
  itens      ItemNotaEntrada[]

  @@unique([empresaId, chaveAcesso])
  @@index([empresaId, criadoEm])
  @@index([fornecedorId])
  @@map("notas_entrada")
}

model ItemNotaEntrada {
  id               String  @id @default(uuid())
  empresaId        String
  notaEntradaId    String
  /// Nulo enquanto a nota está PENDENTE e o item ainda não foi decidido/vinculado.
  produtoId        String?
  numeroItem       Int
  codigoFornecedor String?
  descricao        String?
  quantidade       Float
  unidade          String  @default("UN")
  valorUnitario    Decimal @db.Decimal(18, 4)
  valorTotal       Decimal @db.Decimal(18, 4)
  ipi              Float?
  ncm              String?
  cest             String?
  origemFiscal     String?
  controlaEstoque  Boolean @default(true)

  nota    NotaEntrada @relation(fields: [notaEntradaId], references: [id], onDelete: Cascade)
  produto Produto?    @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([notaEntradaId])
  @@index([empresaId, produtoId])
  @@map("itens_nota_entrada")
}

model Produto {
  id              String   @id @default(uuid())
  empresaId       String
  sku             String?
  nome            String
  descricao       String?
  unidade         String   @default("un")
  /// NCM (8 dígitos) para emissão de NF-e.
  ncm             String?
  precoVenda      Float    @default(0)
  estoqueAtual    Float    @default(0)
  estoqueMinimo   Float    @default(0)
  controlaEstoque Boolean  @default(true)
  ativo           Boolean  @default(true)
  /// Identidade estável por empresa. Nulo até a geração da personalização. Não é o SKU.
  codigoInterno   String?
  nomeFiscal      String?
  descricaoComercial String?
  /// Código do item no catálogo do fornecedor (texto). Permanece além do vínculo opcional.
  codigoFornecedor String?
  /// Preparação ECOL-07. Nulo nos produtos atuais; não obrigatório.
  fornecedorId    String?
  ean             String?
  cest            String?
  origemFiscal    String?
  /// IPI e margem: estrutura da ECOL-04a. Sem fórmula nesta tarefa.
  ipi             Float?
  margem          Float?
  /// Custo médio e último preço: DECIMAL(18,4) — quatro casas internas (ECOL-05 / 7.7).
  custoMedio      Decimal? @db.Decimal(18, 4)
  ultimoPreco     Decimal? @db.Decimal(18, 4)
  /// Reservado à P5. Não entra em conta.
  fatorConversao  Float?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  fornecedor       Fornecedor?       @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  itensOrcamento   ItemOrcamento[]
  itensPedido      ItemPedido[]
  movimentacoes    MovimentacaoEstoque[]
  itensNotaEntrada ItemNotaEntrada[]

  @@index([empresaId])
  @@index([empresaId, ativo])
  @@index([fornecedorId])
  @@unique([empresaId, sku])
  @@unique([empresaId, codigoInterno])
  @@map("produtos")
}

model Orcamento {
  id                String          @id @default(uuid())
  empresaId         String
  oportunidadeId    String
  numero            String
  versao            Int             @default(1)
  status            StatusOrcamento @default(RASCUNHO)
  vigente           Boolean         @default(false)
  observacoes       String?
  descontoValor     Float           @default(0)
  /// ECOL-13 — desconto geral em R$ ou % (sem dupla aplicação).
  descontoTipo      TipoDescontoOrcamento @default(VALOR)
  descontoPercentual Float?
  subtotal          Float           @default(0)
  total             Float           @default(0)
  validadeEm        DateTime?
  arquivoId         String?
  enviadoEm         DateTime?
  aceitoEm          DateTime?
  convertidoEm      DateTime?
  criadoPorId       String?
  /// ECOL-12 — orçamento de origem da duplicação (“Baseado em”).
  orcamentoOrigemId String?
  criadoEm          DateTime        @default(now())
  atualizadoEm      DateTime        @updatedAt

  oportunidade    Oportunidade    @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  orcamentoOrigem Orcamento?      @relation("OrcamentoBaseadoEm", fields: [orcamentoOrigemId], references: [id], onDelete: SetNull)
  derivados       Orcamento[]     @relation("OrcamentoBaseadoEm")
  itens           ItemOrcamento[]
  /// ECOL-16 — no máximo um pedido por orçamento (unique em Pedido.orcamentoId).
  pedido          Pedido?
  notasFiscais    NotaFiscal[]

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([oportunidadeId, versao])
  @@index([oportunidadeId, vigente])
  @@index([orcamentoOrigemId])
  @@map("orcamentos")
}

/// ECOL-16 — pedido comercial. Conversão operacional completa (estoque, pagamentos,
/// comissão, checklist, status CONVERTIDO do orçamento) fica na ECOL-17.
model Pedido {
  id                 String               @id @default(uuid())
  empresaId          String
  oportunidadeId     String
  orcamentoId        String               @unique
  numero             String
  status             StatusPedido         @default(CONFIRMADO)
  observacoes        String?
  descontoValor      Float                @default(0)
  descontoTipo       TipoDescontoOrcamento @default(VALOR)
  descontoPercentual Float?
  subtotal           Float                @default(0)
  total              Float                @default(0)
  criadoPorId        String?
  canceladoEm        DateTime?
  canceladoPorId     String?
  motivoCancelamento String?
  /// ECOL-19 � coluna Kanban enquanto CONFIRMADO.
  faseKanban         FaseKanbanPedido      @default(PEDIDO_CONFIRMADO)
  finalizadoEm       DateTime?
  criadoEm           DateTime             @default(now())
  atualizadoEm       DateTime             @updatedAt

  oportunidade Oportunidade @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  orcamento    Orcamento    @relation(fields: [orcamentoId], references: [id], onDelete: Restrict)
  itens        ItemPedido[]
  pagamentos   PagamentoPedido[]
  comissao     ComissaoPedido?
  checklist    ChecklistItemPedido[]
  itensSeparacao ItemSeparacaoPedido[]
  itensCompra    ItemCompraPedido[]
  historicoFases HistoricoFasePedido[]
  atividades     Atividade[]
  notasFiscais   NotaFiscal[]

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([oportunidadeId])
  @@map("pedidos")
}

model ItemPedido {
  id            String  @id @default(uuid())
  pedidoId      String
  produtoId     String?
  nome          String
  unidade       String  @default("un")
  quantidade    Float
  precoUnitario Float
  desconto      Float   @default(0)
  totalLinha    Float
  ordem         Int     @default(0)
  codigoInterno String?

  pedido  Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  itensNota ItemNotaFiscal[]

  @@index([pedidoId])
  @@index([produtoId])
  @@map("itens_pedido")
}

/// ECOL-19 � movimento manual/autom�tico do card de pedido.
model HistoricoFasePedido {
  id           String   @id @default(uuid())
  empresaId    String
  pedidoId     String
  faseAnterior String?
  faseNova     String
  origem       String
  usuarioId    String?
  motivo       String?
  criadoEm     DateTime @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([pedidoId])
  @@map("historico_fase_pedido")
}

/// ECOL-17 — linha de pagamento do pedido (§11.4).
model PagamentoPedido {
  id           String                @id @default(uuid())
  empresaId    String
  pedidoId     String
  modelo       ModeloPagamentoPedido
  forma        String
  valor        Decimal               @db.Decimal(18, 4)
  vencimentoEm DateTime?
  status       StatusPagamentoPedido @default(PREVISTO)
  recebidoEm   DateTime?
  ordem        Int                   @default(0)
  criadoEm     DateTime              @default(now())
  atualizadoEm DateTime              @updatedAt

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([pedidoId])
  @@map("pagamentos_pedido")
}

/// ECOL-17 — comissão do parceiro (§9.3). Base padrão = total do pedido (P1 / 16.4).
model ComissaoPedido {
  id            String              @id @default(uuid())
  empresaId     String
  pedidoId      String              @unique
  parceiroId    String
  rtPercentual  Decimal             @db.Decimal(7, 4)
  baseCalculo   Decimal             @db.Decimal(18, 4)
  valorComissao Decimal             @db.Decimal(18, 4)
  status        StatusComissaoPedido @default(A_PAGAR)
  pagoEm        DateTime?
  formaPagamento String?
  criadoEm      DateTime            @default(now())
  atualizadoEm  DateTime            @updatedAt

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([parceiroId])
  @@map("comissoes_pedido")
}

model ChecklistItemPedido {
  id          String              @id @default(uuid())
  empresaId   String
  pedidoId    String
  tipo        TipoChecklistPedido
  rotulo      String
  /// Se false, não entra no critério de 100% (ex.: NF futura, comissão sem parceiro).
  aplicavel   Boolean             @default(true)
  /// Manual vs ganchos futuros (NF/Agenda/comissão).
  automatico  Boolean             @default(false)
  concluido   Boolean             @default(false)
  concluidoEm DateTime?
  usuarioId   String?
  ordem       Int                 @default(0)
  criadoEm    DateTime            @default(now())
  atualizadoEm DateTime           @updatedAt

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@unique([pedidoId, tipo])
  @@index([empresaId])
  @@index([pedidoId])
  @@map("checklist_itens_pedido")
}

model ItemSeparacaoPedido {
  id         String @id @default(uuid())
  pedidoId   String
  produtoId  String
  nome       String
  quantidade Float
  ordem      Int    @default(0)

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@map("itens_separacao_pedido")
}

model ItemCompraPedido {
  id              String @id @default(uuid())
  pedidoId        String
  produtoId       String
  nome            String
  quantidadeFalta Float
  ordem           Int    @default(0)

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@map("itens_compra_pedido")
}

/// ECOL-13 — origem do custoBase na linha (snapshot; não segue alteração do produto).
enum BaseCustoItemOrcamento {
  ULTIMO_PRECO
  CUSTO_MEDIO
  INFORMADO
}

enum TipoDescontoOrcamento {
  VALOR
  PERCENTUAL
}

model ItemOrcamento {
  id             String                 @id @default(uuid())
  orcamentoId    String
  produtoId      String?
  nome           String
  unidade        String                 @default("un")
  quantidade     Float
  precoUnitario  Float
  desconto       Float                  @default(0)
  totalLinha     Float
  ordem          Int                    @default(0)
  /// ECOL-13 — snapshot da linha (não altera o produto).
  codigoInterno  String?
  baseCusto      BaseCustoItemOrcamento?
  custoBase      Decimal?               @db.Decimal(18, 4)
  ipiPercentual  Decimal?               @db.Decimal(7, 4)
  stPercentual   Decimal?               @db.Decimal(7, 4)
  margem         Decimal?               @db.Decimal(18, 4)
  precoManual    Boolean                @default(false)
  margemEfetiva  Decimal?               @db.Decimal(18, 4)

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  produto   Produto?  @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  @@index([orcamentoId])
  @@index([produtoId])
  @@map("itens_orcamento")
}

model MovimentacaoEstoque {
  id             String                  @id @default(uuid())
  empresaId      String
  produtoId      String
  tipo           TipoMovimentacaoEstoque
  quantidade     Float
  saldoApos      Float
  orcamentoId    String?
  oportunidadeId String?
  /// ECOL-17 � origem da baixa pelo pedido.
  pedidoId       String?
  observacao     String?
  usuarioId      String?
  /// Preenchidos pelas tarefas de ajuste e custo. Nulos no histórico já gravado.
  motivo         String?
  precoUnitarioCusto Decimal? @db.Decimal(18, 4)
  criadoEm       DateTime                @default(now())

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([empresaId, criadoEm])
  @@index([produtoId, criadoEm])
  @@index([orcamentoId])
  @@index([pedidoId])
  @@map("movimentacoes_estoque")
}

model NotaFiscal {
  id              String          @id @default(uuid())
  empresaId       String
  orcamentoId     String
  oportunidadeId  String
  /// ECOL-24 — vínculo ao pedido (emissão Ecolume). Legado pode ficar nulo.
  pedidoId        String?
  status          StatusNotaFiscal @default(RASCUNHO)
  chaveAcesso     String?
  numero          String?
  serie           String?
  protocolo       String?
  mensagemErro    String?
  idExternoFocus  String?
  refFocus        String?
  arquivoXmlId    String?
  arquivoPdfId    String?
  payloadEnvio    Json?
  respostaFocus   Json?
  autorizadoEm    DateTime?
  criadoPorId     String?
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt

  orcamento    Orcamento    @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  oportunidade Oportunidade @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  pedido       Pedido?      @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  itens        ItemNotaFiscal[]
  eventos      EventoNotaFiscal[]

  @@index([empresaId])
  @@index([orcamentoId])
  @@index([oportunidadeId])
  @@index([pedidoId])
  @@index([empresaId, status])
  @@unique([empresaId, refFocus])
  @@map("notas_fiscais")
}

/// ECOL-28b — evento fiscal da NF-e: CC-e (CCE) ou envio de e-mail DANFE/XML (EMAIL).
model EventoNotaFiscal {
  id              String   @id @default(uuid())
  empresaId       String
  notaFiscalId    String
  /// CCE | EMAIL
  tipo            String
  /// AUTORIZADO | REJEITADO | AGENDADO | ERRO
  status          String
  numeroSequencia Int?
  texto           String?
  emails          String[] @default([])
  protocolo       String?
  respostaFocus   Json?
  mock            Boolean  @default(false)
  criadoPorId     String?
  criadoEm        DateTime @default(now())

  nota NotaFiscal @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)

  @@index([empresaId, notaFiscalId])
  @@map("eventos_nota_fiscal")
}

/// ECOL-24 — linha faturada (snapshot); quantidade controla parcial/total.
model ItemNotaFiscal {
  id            String  @id @default(uuid())
  empresaId     String
  notaFiscalId  String
  itemPedidoId  String?
  produtoId     String?
  codigoInterno String?
  descricao     String
  ncm           String?
  cest          String?
  origemFiscal  String?
  unidade       String  @default("UN")
  quantidade    Decimal @db.Decimal(18, 4)
  precoUnitario Decimal @db.Decimal(18, 4)
  valorTotal    Decimal @db.Decimal(18, 4)
  ordem         Int     @default(0)

  nota       NotaFiscal @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)
  itemPedido ItemPedido? @relation(fields: [itemPedidoId], references: [id], onDelete: SetNull)

  @@index([notaFiscalId])
  @@index([itemPedidoId])
  @@index([empresaId])
  @@map("itens_nota_fiscal")
}

/// Trilha da seção 16.3. Sem atualizadoEm: o registro não é editável pela aplicação.
model LogAuditoria {
  id         String   @id @default(uuid())
  empresaId  String
  usuarioId  String?
  tipo       String
  entidade   String
  entidadeId String
  anterior   Json?
  posterior  Json?
  criadoEm   DateTime @default(now())

  @@index([empresaId, criadoEm])
  @@index([empresaId, usuarioId])
  @@index([empresaId, tipo, criadoEm])
  @@map("logs_auditoria")
}
