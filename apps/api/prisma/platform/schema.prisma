// Banco da plataforma. Não guarda pessoas, obras, negócios, estoque nem orçamento.

generator client {
  provider = "prisma-client-js"
  output   = "../../src/database/generated/platform"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

enum PerfilUsuario {
  PROPRIETARIO
  GESTOR
  VENDEDOR
  ATENDENTE
}

enum RamoProduto {
  CONSTRUCAO
  SAUDE
}

enum SegmentoEmpresa {
  ILUMINACAO
  PISOS_REVESTIMENTOS
  ESQUADRIAS
  CONCRETO
  MATERIAIS_CONSTRUCAO
  SERVICOS_OBRAS
  OUTRO
}

model Empresa {
  id                String          @id @default(uuid())
  nome              String
  nomeFantasia      String?
  ramo              RamoProduto     @default(CONSTRUCAO)
  segmento          SegmentoEmpresa @default(OUTRO)
  telefone          String?
  cidade            String?
  estado            String?
  logoArquivoId     String?
  cnpj              String?
  inscricaoEstadual String?
  enderecoFiscal    Json?
  configuracoes     Json            @default("{}")
  /// Onde está o database operacional desta empresa.
  databaseHost      String          @default("localhost")
  databasePort      Int             @default(5432)
  databaseName      String
  criadoEm          DateTime        @default(now())
  atualizadoEm      DateTime        @updatedAt

  usuarios   Usuario[]
  concessoes ConcessaoPermissao[]
  conjuntos  ConjuntoPermissao[]

  @@map("empresas")
}

model Usuario {
  id              String        @id @default(uuid())
  empresaId       String
  nome            String
  email           String        @unique
  senhaHash       String
  perfil          PerfilUsuario @default(VENDEDOR)
  ativo           Boolean       @default(true)
  deveTrocarSenha Boolean       @default(false)
  versaoSessao    Int           @default(0)
  ultimoAcessoEm  DateTime?
  criadoEm        DateTime      @default(now())
  atualizadoEm    DateTime      @updatedAt

  empresa    Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  concessoes ConcessaoPermissao[]

  @@index([empresaId])
  @@map("usuarios")
}

/// Perfil reutilizável de permissões (template). Aplicar copia chaves ao usuário; não sincroniza depois.
model ConjuntoPermissao {
  id           String   @id @default(uuid())
  empresaId    String
  nome         String
  chaves       String[]
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("conjuntos_permissao")
}

/// Chave concedida a um usuário. conjuntoId = último template aplicado (metadado; não sincroniza).
model ConcessaoPermissao {
  id         String   @id @default(uuid())
  empresaId  String
  usuarioId  String
  chave      String
  conjuntoId String?
  criadoEm   DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, chave])
  @@index([empresaId, usuarioId])
  @@map("concessoes_permissao")
}

/// Trilha de permissão. Fica neste banco para entrar na mesma transação da concessão.
/// Sem chave estrangeira: apagar a empresa não apaga o histórico por cascata.
model LogAuditoria {
  id         String   @id @default(uuid())
  empresaId  String
  usuarioId  String?
  tipo       String
  entidade   String
  entidadeId String
  anterior   Json?
  posterior  Json?
  criadoEm   DateTime @default(now())

  @@index([empresaId, criadoEm])
  @@index([empresaId, usuarioId])
  @@index([empresaId, tipo, criadoEm])
  @@map("logs_auditoria")
}
